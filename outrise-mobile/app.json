{
  "expo": {
    "name": "Outrise",
    "slug": "outrise",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "outrise",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
